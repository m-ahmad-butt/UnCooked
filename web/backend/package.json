{
  "name": "hackathon-backend-monolith",
  "version": "1.0.0",
  "description": "Hackathon Backend Monolith with Mongoose",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node tests/run.js tests",
    "test:unit": "node tests/run.js tests/unit",
    "test:smoke": "node tests/run.js tests/smoke",
    "test:coverage": "c8 --reporter=lcov --reporter=text --reports-dir=coverage npm run test:unit"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "axios": "^1.15.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "qs": "^6.16.2"
  }
